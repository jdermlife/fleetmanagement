ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@database-host:5432/fms?sslmode=require
AUTO_RUN_SCHEMA_MIGRATIONS=false

ENFORCE_AUTH=true
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_IOS_CLIENT_ID=replace-with-google-ios-client-id
APPLE_OAUTH_CLIENT_ID=com.quantech.filscore.web
APPLE_REDIRECT_URI=https://filscore-ai.quantech.international/api/auth/apple/callback
APPLE_ANDROID_REDIRECT_URI=filscore://apple-callback
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret

FRONTEND_ORIGINS=https://fleetmanagement.vercel.app,https://fleetmanagement-flame.vercel.app,https://filscore-ai.quantech.international
FRONTEND_ORIGIN_REGEX=^https://fleetmanagement(?:-[a-z0-9-]+)?(?:-jdionedas-projects)?\.vercel\.app$

ENABLE_RATE_LIMIT=true
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379/0
ENABLE_API_DOCS=false

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
AI_PROVIDER_MODE=openai
SENTRY_DSN=