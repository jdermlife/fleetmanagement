# Backend environment template
# Copy to backend/.env and replace placeholder values.

ENVIRONMENT=production

# Database
DATABASE_URL=postgresql://username:password@db-host:5432/fms?sslmode=require
AUTO_RUN_SCHEMA_MIGRATIONS=false

# Authentication
ENFORCE_AUTH=true
SECRET_KEY=replace-with-strong-64-hex-or-random-string
TOKEN_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30
GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=your-apple-service-id
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# CORS
FRONTEND_ORIGINS=https://fleetmanagement.vercel.app,https://fleetmanagement-flame.vercel.app,https://filscore-ai.quantech.international,https://www.filscore-ai.quantech.international
FRONTEND_ORIGIN_REGEX=^https://fleetmanagement(?:-[a-z0-9-]+)?(?:-jdionedas-projects)?\.vercel\.app$

# Rate limiting
ENABLE_RATE_LIMIT=true
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis-host:6379/0
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# API docs
ENABLE_API_DOCS=false

# AI providers
# OpenAI remains primary. In hybrid mode, Ollama is used only for confirmed
# credit/spend exhaustion unless AI_HYBRID_FALLBACK_POLICY=any_error is set.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
AI_PROVIDER_MODE=openai
AI_HYBRID_PRIMARY=openai
AI_HYBRID_FALLBACK_POLICY=quota_only
AI_GOVERNANCE_LOGGING_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# Notifications
NOTIFICATION_DISPATCHER_ENABLED=true
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=30
NOTIFICATION_DISPATCH_BATCH_SIZE=100
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_TIMEOUT_SECONDS=15
NEW_USER_ADMIN_NOTIFICATION_RECIPIENTS=jdioneda@gmail.com,jdioneda@quantech.international

# Profile history retention
HISTORY_RETENTION_ENABLED=true
HISTORY_RETENTION_INTERVAL_SECONDS=86400
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60

# PayMongo hosted subscription checkout
# Keep these secrets on the backend only. Never expose them as VITE_ variables.
PAYMONGO_SECRET_KEY=replace-with-paymongo-secret-key
PAYMONGO_WEBHOOK_SECRET=replace-with-paymongo-webhook-signing-secret
PAYMONGO_SUCCESS_URL=https://fleetmanagement-flame.vercel.app/subscription-payment?checkout=success
PAYMONGO_CANCEL_URL=https://fleetmanagement-flame.vercel.app/subscription-payment?checkout=cancelled
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,grab_pay
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

# PayPal Orders API
# Keep the client secret on the backend. Use matching sandbox or live credentials
# with the corresponding API base URL and frontend JavaScript SDK client ID.
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id
PAYPAL_API_BASE_URL=https://api-m.paypal.com
PAYPAL_TIMEOUT_SECONDS=15
